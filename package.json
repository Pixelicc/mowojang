{
  "name": "mowojang",
  "version": "0.8.3",
  "description": "A simple TypeScript compatible wrapper for the Mowojang-API.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm tsup",
    "prepare": "pnpm build",
    "test": "node test test/index.js",
    "lint:check": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixelicc/mowojang"
  },
  "keywords": [
    "Minecraft",
    "Mowojang",
    "Wrapper",
    "API"
  ],
  "author": "Pixelic",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "axios-cache-interceptor": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pixelic/logger": "npm:@jsr/pixelic__logger@^0.3.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
